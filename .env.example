NEXT_PUBLIC_APP_URL=https://example.com

# https://github.com/settings/tokens
GITHUB_API_TOKEN=

# https://github.com/grubersjoe/github-contributions-api
GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de

# Self-hosted Umami (see docs/umami-self-hosting.md)
# Base URL of your Umami deployment, no trailing slash.
NEXT_PUBLIC_UMAMI_URL=
# Website id from Umami → Settings → Websites.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# For the Insights chart: an API key (Umami → Settings → API keys) …
UMAMI_API_KEY=
# … or, if your Umami version has no API keys, a login instead.
UMAMI_USERNAME=
UMAMI_PASSWORD=

ADS_TXT=

# External RSS/Atom feeds aggregated on /blog (comma-separated). Optional.
RSS_FEED_URLS=
